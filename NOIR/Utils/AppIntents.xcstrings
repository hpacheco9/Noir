    "apple_pay_intent.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasst eine Apple-Pay-Zahlung als Ausgabe, ohne Rückfragen. Gedacht für eine Wallet-Automation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save an Apple Pay payment as an expense without asking anything. Made for a Wallet automation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda un pago con Apple Pay como gasto, sin hacer preguntas. Pensado para una automatización de Wallet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre un paiement Apple Pay comme dépense, sans poser de questions. Conçu pour une automatisation Wallet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva um pagamento do Apple Pay como despesa, sem perguntar nada. Feito para uma automação do Wallet."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda um pagamento do Apple Pay como despesa, sem perguntar nada. Pensado para uma automatização do Wallet."
