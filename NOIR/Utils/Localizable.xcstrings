        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique ton nom pour personnaliser ton expérience dans Noir."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortell oss hva du heter, så kan vi tilpasse opplevelsen din i Noir."
