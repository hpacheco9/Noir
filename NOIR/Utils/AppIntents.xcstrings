    "apple_pay_intent.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem en Apple Pay-betaling som udgift uden at stille spørgsmål. Designet til en Wallet-automatisering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasst eine Apple-Pay-Zahlung als Ausgabe, ohne Rückfragen. Gedacht für eine Wallet-Automation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save an Apple Pay payment as an expense without asking anything. Made for a Wallet automation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda un pago con Apple Pay como gasto, sin hacer preguntas. Pensado para una automatización de Wallet."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallentaa Apple Pay -maksun kuluksi kysymättä mitään. Tarkoitettu Lompakon automaatiota varten."
          }
