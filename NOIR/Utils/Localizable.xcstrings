    "onboarding.name.subtitle" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortæl os dit navn, så vi kan tilpasse din oplevelse i Noir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag uns deinen Namen, damit wir Noir für dich personalisieren können."
          }
