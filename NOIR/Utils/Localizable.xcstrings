    "preferences.intent_summary_footer" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser udgiften med Gem og Annuller, før genvejen Tilføj udgift gemmer den. Når den er slået fra, gemmes udgiften lige efter datoen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Ausgabe mit den Tasten „Sichern“ und „Abbrechen“ an, bevor der Kurzbefehl „Ausgabe hinzufügen“ sie sichert. Ist die Option deaktiviert, wird die Ausgabe direkt nach der Eingabe des Datums gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the expense with Save and Cancel before the Add Expense shortcut saves it. When off, it saves right after the date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el gasto con “Guardar” y “Cancelar” antes de que el atajo “Registrar gasto” lo guarde. Si lo desactivas, se guarda en cuanto indicas la fecha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää kulun Tallenna- ja Peruuta-painikkeineen ennen kuin Lisää kulu -pikakomento tallentaa sen. Kun asetus on pois päältä, kulu tallennetaan heti päivämäärän jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la dépense avec les boutons « Enregistrer » et « Annuler » avant que le raccourci « Ajouter une dépense » ne l’enregistre. Si l’option est désactivée, la dépense est enregistrée dès que la date est indiquée."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser utgiften med knappene Lagre og Avbryt før snarveien Legg til utgift lagrer den. Når den er slått av, lagres utgiften rett etter datoen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra a despesa com Salvar e Cancelar antes que o atalho “Adicionar Despesa” a salve. Quando desativada, a despesa é salva assim que você informa a data."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra a despesa com Guardar e Cancelar antes de o atalho Adicionar despesa a guardar. Desligado, guarda logo após a data."
          }
        }
      }
    },
