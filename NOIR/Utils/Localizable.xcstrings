        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinos tu nombre para que personalicemos tu experiencia en Noir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerro nimesi, niin voimme personoida Noir-kokemuksesi."
